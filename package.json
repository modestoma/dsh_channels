{
  "name": "dsh-channels",
  "version": "0.1.0",
  "description": "DeepSeek Harness (DSH) 飞书渠道插件：一个 dsh 实例对应一个飞书机器人，私聊/群聊/话题群 @ 触发会话，话题绑定 session，卡片 2.0 流式回复；Web 设置里提供「飞书渠道」状态与常用配置面板",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "README.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:client": "tsdown",
    "verify:client": "node scripts/verify-client-loader.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build:client && pnpm verify:client"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "im-bridge",
    "web-ui",
    "settings-panel"
  ],
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.31",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
